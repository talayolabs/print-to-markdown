{
  "manifest_version": 3,
  "name": "Print to Markdown",
  "version": "0.1.0",
  "description": "Save, copy or send the current page as Markdown, from Chrome's print dialog, the toolbar, the right-click menu or a shortcut.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "printerProvider",
    "scripting",
    "downloads",
    "contextMenus",
    "storage",
    "offscreen",
    "clipboardWrite",
    "notifications",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Print to Markdown",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": false },
  "commands": {
    "md-copy": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Copy page as Markdown"
    },
    "md-save": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save page as Markdown"
    },
    "md-claude": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Send page to Claude"
    }
  }
}
